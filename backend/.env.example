# Local development. On Railway, configure these in the backend service Variables.
# Railway DATABASE_URL reference: ${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/web_demo"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
PORT=4000
